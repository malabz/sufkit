PROJECT_NAME           = "sufkit"
PROJECT_NUMBER         = "@PROJECT_VERSION@ (main documentation)"
PROJECT_BRIEF          = "Genome suffix arrays, FM-indexes, exact search, MEM, MAM, SMEM, and MUM search"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@"

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include/sufkit" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen-mainpage.md"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen-mainpage.md"

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = SUFKIT_API=

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

QUIET                  = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES
SOURCE_BROWSER         = NO
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
