root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
